# ── AI Provider Keys (server-side only — never exposed to the browser) ──
# The Express proxy in server/index.js reads these and the frontend calls /api/ai.
# Add whichever providers you have keys for. Missing keys return 501 and the
# client falls back to a simulated response for that model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGING_FACE_API_KEY=

# ── Supabase (server-side only) ─────────────────────────────────────────
# SUPABASE_URL        — your project's REST endpoint (same as VITE_SUPABASE_URL).
# SUPABASE_SERVICE_ROLE_KEY — the secret service_role key. Used ONLY on the
#   backend for the auth proxy endpoints (/api/auth/*). NEVER put this in a
#   VITE_-prefixed variable — it must not enter the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API key encryption — AES-256-GCM for encrypting user LLM API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Set this to a stable value — changing it will invalidate all stored encrypted keys.
API_KEY_ENCRYPTION_KEY=

# ── Frontend origin (for auth redirect links) ───────────────────────────
# Used to build the emailRedirectTo / redirectTo URLs for sign-up confirmation
# and password-reset emails. Must be the publicly reachable frontend origin.
FRONTEND_URL=https://zac-ai.netlify.app

AI_PROXY_PORT=8787
